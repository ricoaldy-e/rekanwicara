# Copy to app/.env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only
# put public values here (Supabase anon key is public by design; RLS protects the data).
# Source: docs/SPEC.md §8, §9

# Server base URL on the LAN, e.g. http://192.168.1.10:8000 (see server/README.md for finding the IP).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Supabase project (anonymous auth + RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# true: shows the hidden Dataset screen (SPEC §8.1, §10). Keep false for the product/demo build.
EXPO_PUBLIC_DATASET_MODE=false

# true: catalog and word data come from the bundled mock (src/mock), not FastAPI /v2. Screens do not change.
EXPO_PUBLIC_USE_MOCK=false

# Which scorer analyzes a recording: v1 (/v1/analyze, default; unknown values = v1), v2 (/v2/analyze), mock (sample results).
EXPO_PUBLIC_ANALYZE_API=v1
