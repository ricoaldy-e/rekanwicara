# Copy to app/.env and fill in. Restart Metro with `npx expo start -c` after every change.
# EXPO_PUBLIC_* values are bundled into the app, so only public values belong here.
# Never put a Supabase service-role key or any server secret in this file.

# --- Server -----------------------------------------------------------------
# Analysis server on the LAN, e.g. http://192.168.1.10:8000 (find the laptop IP with `ipconfig`).
# The phone and the laptop must be on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# --- Supabase ---------------------------------------------------------------
# Project URL and anon/publishable key (public by design; RLS protects the data).
# Enable the Email provider in Supabase Auth; there is no anonymous sign-in.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Behaviour --------------------------------------------------------------
# false: catalog and companion words come from the server (/v2) and the real Supabase account is used.
# true: catalog, accounts and companion words come from the bundled sample data (src/mock); any email and
#       password sign in. Mock sessions use a fake token, which /v2/analyze rejects, so also set
#       EXPO_PUBLIC_ANALYZE_API=mock.
EXPO_PUBLIC_USE_MOCK=false

# Which scorer analyzes a recording.
# v2 (default; unknown values fall back to v2): POST /v2/analyze (lips, voice, Wav2Vec2).
# mock: sample results, nothing is sent to the scorer. v1 is no longer used.
EXPO_PUBLIC_ANALYZE_API=v2

