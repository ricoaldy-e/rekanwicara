# Copy to server/.env and adjust. No secrets belong in this example file.
# Source: docs/SPEC.md §4

# Bind address. 0.0.0.0 so a phone on the same Wi-Fi can reach the laptop.
HOST=0.0.0.0
PORT=8000

# true: /v1/analyze and /v1/calibrate return sample responses without analysis. Keep false for the demo
# (calibration still uses /v1/calibrate; /v2/analyze never honours this flag).
MOCK_MODE=false

# true: enables POST /v1/dataset/upload (dataset recording sessions only).
DATASET_MODE=false

# true: enables GET/POST /v1/debug/features (development only; never during the demo).
DEBUG=false

# Where raw dataset clips, model videos and calibration numbers are stored (relative to server/).
DATA_DIR=../data

# Only accepted value. Wav2Vec2 for /v2/analyze runs in ml/wav2vec2/.venv (see README), not via this flag.
SCORER_MODE=rules

ENGINE_VERSION=0.1.0

# Upload size limit in megabytes.
MAX_UPLOAD_MB=15

# MediaPipe Face Landmarker model (download with: python scripts/download_models.py). Relative to server/.
FACE_MODEL_PATH=models/face_landmarker.task

# Folder for per-request temporary media (always deleted after the request). Empty = system temp.
TMP_DIR=

# Required for account deletion and team tutorial uploads. HTTPS project URL; server-only key.
# Never put the service role key in app/.env or EXPO_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JSON array of team recorder Auth UUIDs; empty denies all tutorial production access.
TUTORIAL_UPLOADER_IDS=[]

# Google Gemini through its Chat Completions-compatible HTTPS endpoint (key and model name from Google AI Studio).
# No key/model defaults or frontend credentials. Only target text is sent, never recordings.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
