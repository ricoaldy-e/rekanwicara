# Copy to server/.env and adjust. No secrets belong in this example file.
# Source: docs/SPEC.md §4

# Bind address. 0.0.0.0 so a phone on the same Wi-Fi can reach the laptop.
HOST=0.0.0.0
PORT=8000

# true: /v1/analyze and /v1/calibrate return valid sample responses without analysis.
MOCK_MODE=true

# true: enables POST /v1/dataset/upload (dataset recording sessions only).
DATASET_MODE=false

# true: enables GET/POST /v1/debug/features (development only; never during the demo).
DEBUG=false

# Where raw dataset clips, model videos and calibration numbers are stored (relative to server/).
DATA_DIR=../data

# MVP: always rules (Wav2Vec2 postponed to the roadmap; other values are rejected).
SCORER_MODE=rules

ENGINE_VERSION=0.1.0

# Upload size limit in megabytes.
MAX_UPLOAD_MB=15

# MediaPipe Face Landmarker model (download with: python scripts/download_models.py). Relative to server/.
FACE_MODEL_PATH=models/face_landmarker.task

# Folder for per-request temporary media (always deleted after the request). Empty = system temp.
TMP_DIR=

# Required only for DELETE /v1/auth/account. HTTPS project URL; server-only service role key.
# Never put the service role key in app/.env or EXPO_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
